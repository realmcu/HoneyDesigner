{
  "name": "honeygui-visual-designer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.8.0",
  "license": "MIT",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/realmcu/HoneyGUI.git"
  },
  "homepage": "https://github.com/realmcu/HoneyGUI",
  "bugs": {
    "url": "https://github.com/realmcu/HoneyGUI/issues"
  },
  "publisher": "honeygui-visual-designer",
  "icon": "resources/HoneyGUI-LOGO.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "HoneyGUI",
    "UI Design",
    "Visual Designer",
    "Embedded UI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hml",
        "aliases": [
          "HML",
          "hml"
        ],
        "extensions": [
          ".hml"
        ],
        "configuration": "./hml.language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "honeygui.hmlEditor",
        "displayName": "HoneyGUI Design View",
        "selector": [
          {
            "filenamePattern": "*.hml"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "honeygui-explorer",
          "title": "HoneyGUI Visual Designer",
          "icon": "resources/HoneyGUI-LOGO.svg",
          "priority": 100
        }
      ]
    },
    "views": {
      "honeygui-explorer": [
        {
          "id": "honeygui.welcome",
          "name": "%view.welcome%",
          "icon": "$(home)"
        },
        {
          "id": "honeygui.environment",
          "name": "%view.environment%",
          "icon": "$(checklist)"
        },
        {
          "id": "honeygui.quick",
          "name": "%view.quick%",
          "icon": "$(play)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "honeygui.welcome",
        "contents": "%viewsWelcome.honeygui.welcome%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "honeygui.openInTextEditor",
          "when": "resourceExtname == .hml",
          "group": "1_open@1"
        },
        {
          "command": "honeygui.openInDesigner",
          "when": "resourceExtname == .hml",
          "group": "1_open@2"
        },
        {
          "command": "honeygui.createNewHmlInWorkspace",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "honeygui.environment.refresh",
          "when": "view == honeygui.environment",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "honeygui.createNewHmlInWorkspace",
        "title": "%command.createNewHml%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.tools",
        "title": "%command.tools%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.mapTools",
        "title": "%command.mapTools%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.openInTextEditor",
        "title": "%command.openInTextEditor%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.openInDesigner",
        "title": "%command.openInDesigner%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.newProject",
        "title": "%command.newProject%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.openProject",
        "title": "%command.openProject%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.codegen",
        "title": "%command.codegen%",
        "category": "HoneyGUI"
      },
      {
        "command": "honeygui.simulation",
        "title": "%command.simulation%",
        "category": "HoneyGUI",
        "icon": "$(rocket)"
      },
      {
        "command": "honeygui.simulation.debug",
        "title": "%command.simulationDebug%",
        "category": "HoneyGUI",
        "icon": "$(bug)"
      },
      {
        "command": "honeygui.convertResource",
        "title": "%command.convertResource%",
        "category": "HoneyGUI",
        "icon": "$(package)"
      },
      {
        "command": "honeygui.simulation.stop",
        "title": "%command.simulationStop%",
        "category": "HoneyGUI",
        "icon": "$(debug-stop)"
      },
      {
        "command": "honeygui.environment.refresh",
        "title": "%command.refreshEnvironment%",
        "category": "HoneyGUI",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "honeygui.simulation.stop",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "HoneyGUI",
      "properties": {
        "honeygui.codegen.language": {
          "type": "string",
          "default": "cpp",
          "enum": [
            "cpp",
            "c"
          ],
          "description": "代码生成语言"
        },
        "honeygui.codegen.outputDir": {
          "type": "string",
          "default": "src/ui",
          "description": "代码输出目录"
        },
        "honeygui.hml.outputDir": {
          "type": "string",
          "default": "ui",
          "description": "HML输出目录"
        },
        "honeygui.ui.gridSize": {
          "type": "number",
          "default": 8,
          "description": "网格大小"
        },
        "honeygui.ui.snapToGrid": {
          "type": "boolean",
          "default": true,
          "description": "启用网格吸附"
        },
        "honeygui.codeGeneration.outputPath": {
          "type": "string",
          "default": "src",
          "description": "代码生成输出路径"
        },
        "honeygui.codeGeneration.enableDebugInfo": {
          "type": "boolean",
          "default": true,
          "description": "启用调试信息"
        }
      }
    }
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "cd tools && npx jest --verbose",
    "test:e2e": "npm run compile && node ./out/src/test/runTest.js",
    "test:templates": "npm run compile && node ./out/test/templates/run-templates-tests.js",
    "check:deps": "node scripts/check-dependencies.js",
    "update:deps": "node scripts/update-vscodeignore.js",
    "prepackage": "npm run check:deps",
    "test:video-formats": "npx ts-node scripts/test-three-formats.ts",
    "test:video-formats:quick": "node test-formats-quick.js",
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "node scripts/prepare-video-converter.js && npm run clean:src && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint . --ext .ts,.tsx",
    "build:webview": "webpack --mode production",
    "build:webview:dev": "webpack --mode development",
    "watch:webview": "webpack --mode development --watch",
    "serve:webview": "webpack serve --mode development",
    "clean": "node scripts/clear-cache.js",
    "clean:src": "node scripts/clean-js.js",
    "clean:all": "npm run clean && rimraf node_modules && npm install",
    "rebuild": "npm run clean && npm run compile && npm run build:webview",
    "prepare:lib": "./scripts/prepare-lib-sim.sh",
    "package": "npm run compile && npm run build:webview && vsce package"
  },
  "devDependencies": {
    "@types/bmp-js": "^0.1.2",
    "@types/ini": "^4.1.1",
    "@types/jest": "^30.0.0",
    "@types/jpeg-js": "^0.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.25",
    "@types/opentype.js": "^1.3.8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@types/vscode": "^1.80.0",
    "@types/webpack": "^5.28.5",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "baseline-browser-mapping": "^2.9.14",
    "css-loader": "^7.1.2",
    "esbuild": "^0.27.0",
    "eslint": "^10.4.1",
    "eslint-plugin-import-x": "^4.16.2",
    "fast-check": "^4.5.3",
    "glob": "^11.0.3",
    "globals": "^17.6.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.2.0",
    "mini-css-extract-plugin": "^2.9.4",
    "mocha": "^11.7.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.60.1",
    "webpack": "^5.102.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@csstools/css-parser-algorithms": "^3.0.5",
    "@csstools/css-tokenizer": "^3.0.4",
    "argparse": "^2.0.0",
    "bit-buffer": "^0.2.5",
    "bmp-js": "^0.1.0",
    "chokidar": "^3.6.0",
    "debug": "^4.3.3",
    "fabric": "^7.1.0",
    "fast-xml-parser": "^4.3.2",
    "html2canvas": "^1.4.1",
    "ini": "^4.1.3",
    "jpeg-js": "^0.4.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.562.0",
    "make-error": "^1.3.5",
    "minimatch": "^10.0.1",
    "mkdirp": "^1.0.4",
    "mp4box": "^0.5.2",
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0",
    "qrcode-generator": "1.4.4",
    "three": "^0.181.2",
    "xml-js": "^1.6.11",
    "zustand": "^5.0.8"
  }
}
