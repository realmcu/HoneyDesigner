<?xml version="1.0" encoding="UTF-8"?>
<hml>
  <meta>
    <title>Nav Graph Home</title>
    <project>
      <name>nav-graph-test</name>
      <resolution>240X240</resolution>
      <pixelMode>RGB565</pixelMode>
    </project>
  </meta>

  <view id="main">
    <!-- 场景：view 自身手势跳转 + 按钮跳转 + 定时器跳转（目标跨文件撞名）+ 嵌套 view（剪枝） -->
    <hg_view id="view_home" x="0" y="0" w="240" h="240">
      <events>
        <event type="onSwipeLeft">
          <action type="switchView" target="view_settings" switchOutStyle="SWITCH_OUT_TO_LEFT_USE_TRANSLATION" switchInStyle="SWITCH_IN_FROM_RIGHT_USE_TRANSLATION" />
        </event>
      </events>
      <hg_button id="btn_go_settings" x="20" y="20" w="100" h="40" text="Settings">
        <events>
          <event type="onClick">
            <action type="switchView" target="view_settings" switchOutStyle="SWITCH_OUT_TO_RIGHT_USE_TRANSLATION" switchInStyle="SWITCH_IN_FROM_LEFT_USE_TRANSLATION" />
          </event>
        </events>
      </hg_button>
      <hg_label id="lbl_timer_jump" x="20" y="120" w="120" h="30" text="timer jump" fontSize="16" color="#FFFFFF" timers='[{"id":"timer_jump","name":"jump","enabled":true,"interval":3000,"reload":false,"mode":"preset","actions":[{"type":"switchView","target":"view_dup","switchOutStyle":"SWITCH_OUT_TO_LEFT_USE_TRANSLATION","switchInStyle":"SWITCH_IN_FROM_RIGHT_USE_TRANSLATION"}]}]' />
      <!-- 嵌套 hg_view：其内部按钮的边必须归属 view_nested，而不是 view_home -->
      <hg_view id="view_nested" x="0" y="160" w="240" h="80">
        <hg_button id="btn_nested_back" x="10" y="10" w="80" h="30" text="Back">
          <events>
            <event type="onClick">
              <action type="switchView" target="view_home" switchOutStyle="SWITCH_OUT_TO_RIGHT_USE_TRANSLATION" switchInStyle="SWITCH_IN_FROM_LEFT_USE_TRANSLATION" />
            </event>
          </events>
        </hg_button>
      </hg_view>
    </hg_view>
  </view>
</hml>
