<?xml version="1.0" encoding="UTF-8"?>
<hml>
  <meta>
    <title>Nav Graph Settings</title>
    <project>
      <name>nav-graph-test</name>
      <resolution>240X240</resolution>
      <pixelMode>RGB565</pixelMode>
    </project>
  </meta>

  <view id="settings">
    <!-- 场景：无效目标跳转 -->
    <hg_view id="view_settings" x="0" y="0" w="240" h="240">
      <hg_button id="btn_broken" x="20" y="20" w="100" h="40" text="Broken">
        <events>
          <event type="onClick">
            <action type="switchView" target="view_missing" switchOutStyle="SWITCH_OUT_TO_LEFT_USE_TRANSLATION" switchInStyle="SWITCH_IN_FROM_RIGHT_USE_TRANSLATION" />
          </event>
        </events>
      </hg_button>
    </hg_view>
    <!-- 场景：无 id 的 hg_view（解析器确定性 fallback id 带 basename 种子：settings_hg_view_auto_0） -->
    <hg_view x="0" y="0" w="240" h="240">
      <hg_label id="lbl_no_id_view" x="60" y="100" w="120" h="40" text="no id view" fontSize="16" color="#FFFFFF" />
    </hg_view>
    <!-- 场景：name≠id 的 view（codegen 按 name 注册），home.hml 的 btn_go_extra 以 name "ExtraScreen" 为 target -->
    <hg_view id="view_extra_id" name="ExtraScreen" x="0" y="0" w="240" h="240">
      <hg_label id="lbl_extra" x="60" y="100" w="120" h="40" text="extra" fontSize="16" color="#FFFFFF" />
    </hg_view>
    <!-- 场景：旧格式定时器（timerEnabled="true" + timerActions JSON 属性），parser 应转换为 data.timers 并产出跳转边 -->
    <hg_view id="view_legacy_timer" x="0" y="0" w="240" h="240">
      <hg_label id="lbl_legacy_timer" x="20" y="20" w="120" h="30" text="legacy timer" fontSize="16" color="#FFFFFF" timerEnabled="true" timerMode="preset" timerInterval="2000" timerActions='[{"type":"switchView","target":"view_home","switchOutStyle":"SWITCH_OUT_TO_RIGHT_USE_TRANSLATION","switchInStyle":"SWITCH_IN_FROM_LEFT_USE_TRANSLATION"}]' />
    </hg_view>
  </view>
</hml>
